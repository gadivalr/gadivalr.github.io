---
import type { Dict } from '../i18n';
import SectionHeading from './SectionHeading.astro';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const s = t.skills;
---

<!-- 03. HABILIDADES Y HERRAMIENTAS -->
<section class="space-y-6 pt-2" id="habilidades" aria-labelledby="habilidades-title">
  <SectionHeading id="habilidades-title" heading={s.heading} />
  <div class="space-y-4 py-2">
    {s.groups.map((group) => (
      <div class="leading-snug">
        <span class="font-mono font-bold text-accent text-[14px] block">{group.label}</span>
        <span class="font-serif text-[16px] text-ink block">{group.value}</span>
      </div>
    ))}
  </div>
</section>
