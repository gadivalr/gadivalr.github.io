---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import FlybackSheet from '../../../components/FlybackSheet.astro';
import Footer from '../../../components/Footer.astro';
import { getDict } from '../../../i18n';

const locale = 'en' as const;
const t = getDict(locale);
const meta = t.flyback;
---

<BaseLayout
  locale={locale}
  path="/en/proyectos/flyback/"
  title={`${meta.title} — Leví Gadiel Sojos González`}
  description="Power electronics team project: isolated 10 W flyback converter with remote telemetry (LTspice, PIC18F4550, ESP32, Python/PySide6, KiCad)."
>
  <Header t={t} locale={locale} />
  <main class="max-w-6xl mx-auto px-3 md:px-4 py-8">
    <FlybackSheet t={t} />
  </main>
  <Footer t={t} />
</BaseLayout>
