---
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getDict } from '../../i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data, id }) => {
    return !data.draft && (data.lang === 'es' || id.startsWith('es/'));
  });
  return posts.map((post) => {
    const slug = post.id.replace(/^es\//, '').replace(/\.mdx?$/, '');
    return { params: { slug }, props: { post } };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const locale = 'es' as const;
const t = getDict(locale);
const slug = post.id.replace(/^es\//, '').replace(/\.mdx?$/, '');
const date = post.data.pubDate.toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  locale={locale}
  path={`/blog/${slug}/`}
  title={`${post.data.title} — Blog — Leví Gadiel Sojos González`}
  description={post.data.description ?? post.data.title}
>
  <Header t={t} locale={locale} />
  <main class="max-w-4xl mx-auto px-4 lg:px-10 xl:px-16 py-8">
    <article class="space-y-6">
      <header class="space-y-2 pb-4 border-b border-ink/15">
        <a class="link font-mono text-[13px] text-accent font-semibold" href="/blog/">← Blog</a>
        <p class="font-mono text-[12px] text-accent tracking-widest uppercase">{date}</p>
        <h1 class="font-serif text-2xl md:text-4xl font-semibold text-ink leading-tight text-balance">{post.data.title}</h1>
        {post.data.description && <p class="font-serif text-lg text-ink/80 leading-relaxed">{post.data.description}</p>}
      </header>
      <div class="blog-prose font-serif text-[17px] leading-relaxed text-ink space-y-4">
        <Content />
      </div>
    </article>
  </main>
  <Footer t={t} />
</BaseLayout>

<style is:global>
  .blog-prose h2 { font-family: 'Source Serif 4', Georgia, serif; font-size: 1.5rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.5rem; color: #1A1A1A; }
  .blog-prose h3 { font-family: 'Source Serif 4', Georgia, serif; font-size: 1.2rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.25rem; }
  .blog-prose p { margin: 0.75rem 0; }
  .blog-prose ul, .blog-prose ol { margin: 0.75rem 0 0.75rem 1.5rem; }
  .blog-prose li { margin: 0.25rem 0; }
  .blog-prose a { color: #1F3A8A; text-decoration: underline; text-underline-offset: 2px; }
  .blog-prose code { font-family: 'JetBrains Mono', monospace; font-size: 0.9em; background: rgba(26,26,26,0.06); padding: 0.1em 0.3em; }
  .blog-prose pre { background: #1A1A1A; color: #fef9f0; padding: 1rem; overflow-x: auto; font-family: 'JetBrains Mono', monospace; font-size: 0.9em; }
  .blog-prose pre code { background: transparent; padding: 0; }
  .blog-prose figure { margin: 1.5rem 0; }
  .blog-prose figcaption { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #1A1A1A; margin-top: 0.5rem; }
  .blog-prose img, .blog-prose svg { max-width: 100%; height: auto; border: 1px solid #1A1A1A; }
  .blog-prose .callout { border-left: 3px solid #1F3A8A; padding: 0.75rem 1rem; background: rgba(31,58,138,0.04); font-family: 'JetBrains Mono', monospace; font-size: 14px; }
  .blog-prose hr { border: 0; border-top: 1px solid rgba(26,26,26,0.15); margin: 1.5rem 0; }
</style>
