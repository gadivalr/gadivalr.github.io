---
import type { Dict } from '../i18n';

type FeaturedProject = Dict['projects']['p1'];

interface Props {
  project: FeaturedProject;
  /** Número de figura, p.ej. "Fig. 1.1" */
  figNumber: string;
  /** Imagen (o póster si hay video) */
  figureSrc: string;
  figureAlt: string;
  figureCaption: string;
  /** Dimensiones intrínsecas (evitan CLS) */
  figureWidth?: number;
  figureHeight?: number;
  /** Si es true, la imagen se carga eager (para LCP) */
  loadingEager?: boolean;
  /** Video en bucle para la figura principal (reemplaza imagen; usa figureSrc como póster) */
  figureVideoSrc?: string;
  figureWebmSrc?: string;
  /** Figura/video adicional opcional (p.ej. video HMI en operación) */
  extraFigure?: {
    type: 'video' | 'image';
    src: string;
    number: string;
    caption: string;
    alt?: string;
    width?: number;
    height?: number;
    poster?: string;
  };
}

const {
  project,
  figNumber,
  figureSrc,
  figureAlt,
  figureCaption,
  figureWidth = 512,
  figureHeight = 286,
  loadingEager = false,
  figureVideoSrc,
  figureWebmSrc,
  extraFigure,
} = Astro.props;
---

<!-- HOJA DE REGISTRO TÉCNICO -->
<article class="space-y-4 md:space-y-6 pb-6 md:pb-12">
  <div class="flex flex-col md:flex-row md:items-baseline justify-between pb-2 gap-2">
    <div class="flex flex-col items-start md:flex-row md:items-center gap-1 md:gap-4 w-full">
      <span class="font-mono text-4xl md:text-6xl font-light text-accent">{project.number}</span>
      <div class="w-full">
        <span class="font-mono text-[12px] text-accent tracking-widest uppercase block">{project.kicker}</span>
        <h3 class="font-serif text-xl md:text-3xl font-medium text-ink leading-snug [hyphens:none] [word-break:normal]">
          {project.title}
        </h3>
      </div>
    </div>
  </div>

  <!-- Distribución editorial: Marginalia + Columna Principal -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Marginalia / Notas de laboratorio -->
    <aside class="lg:col-span-4 space-y-4 font-mono text-[13px] border border-ink p-4 bg-paper">
      <div class="space-y-1.5">
        {project.params.map((p) => (
          <div><span class="font-bold">{p.label}:</span> {p.value}</div>
        ))}
        {project.tools && !project.params.some((p) => /herramienta|tool/i.test(p.label)) && (
          <div><span class="font-bold">{project.toolsLabel}:</span> {project.tools}</div>
        )}
      </div>
    </aside>

    <!-- Columna Principal de Lectura -->
    <div class="lg:col-span-8 space-y-5 font-serif text-[17px] leading-relaxed text-ink">
      <div>
        <span class="font-mono text-[13px] font-bold text-accent uppercase tracking-wider block mb-1">{project.problemLabel}</span>
        <p class="font-serif">{project.problem}</p>
      </div>
      <div>
        <span class="font-mono text-[13px] font-bold text-accent uppercase tracking-wider block mb-1">{project.approachLabel}</span>
        <ul class="font-serif list-disc pl-6 space-y-1.5 marker:text-accent">
          {project.approachItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="pt-3 space-y-2 font-mono text-[14px]">
        <div>
          <span class="font-bold text-accent">{project.resultLabel}</span> {project.result}
          {project.resultPending && <span class="to-fill">{project.resultPending}</span>}
        </div>
        {project.links && (
          <div>
            <span class="font-bold text-accent">{project.linksLabel}</span>{' '}
            {project.linksFill ? (
              <span class="to-fill">{project.links}</span>
            ) : 'linksHref' in project && project.linksHref ? (
              <a class="link" href={project.linksHref} target="_blank" rel="noopener noreferrer">{project.links}</a>
            ) : (
              project.links
            )}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Figura técnica (ancho contenido en desktop para mejor visualización) -->
  <div class="space-y-2 pt-2 md:max-w-2xl lg:max-w-3xl md:mx-auto">
    <div class="border border-ink overflow-hidden bg-paper">
      {figureVideoSrc ? (
        <>
          <video
            class="fig-autoplay block w-full h-auto cursor-zoom-in"
            loop
            muted
            playsinline
            preload="none"
            width={figureWidth}
            height={figureHeight}
            poster={figureSrc}
            aria-label={figureAlt}
            data-lazy-video
            data-zoomable-video
            data-video-mp4={figureVideoSrc}
            data-video-webm={figureWebmSrc}
            data-poster={figureSrc}
            data-caption={figureCaption}
            tabindex="0"
            role="button"
          >
            {figureWebmSrc && <source src={figureWebmSrc} type="video/webm" />}
            <source src={figureVideoSrc} type="video/mp4" />
          </video>
          <img
            class="fig-poster-reduced hidden w-full h-auto cursor-zoom-in"
            src={figureSrc}
            alt={figureAlt}
            width={figureWidth}
            height={figureHeight}
            loading={loadingEager ? 'eager' : 'lazy'}
            fetchpriority={loadingEager ? 'high' : undefined}
            decoding="async"
            data-zoomable
            tabindex="0"
            role="button"
            aria-label={Astro.currentLocale === 'en' ? 'Enlarge figure' : 'Ampliar figura'}
          />
        </>
      ) : (
        <img
          src={figureSrc}
          alt={figureAlt}
          width={figureWidth}
          height={figureHeight}
          loading={loadingEager ? 'eager' : 'lazy'}
          fetchpriority={loadingEager ? 'high' : undefined}
          decoding="async"
          class="w-full h-auto block cursor-zoom-in"
          data-zoomable
          tabindex="0"
          role="button"
          aria-label={Astro.currentLocale === 'en' ? 'Enlarge figure' : 'Ampliar figura'}
        />
      )}
    </div>
    <p class="font-mono text-[13px] text-ink">
      <span class="font-bold text-accent">{figNumber}</span> — {figureCaption}
    </p>
  </div>

  {extraFigure && (
    <div class="space-y-2 pt-2 md:max-w-2xl lg:max-w-3xl md:mx-auto">
      <div class="border border-ink overflow-hidden bg-paper">
        {extraFigure.type === 'video' ? (
          <video
            src={extraFigure.src}
            class="block w-full h-auto cursor-zoom-in"
            loop
            muted
            playsinline
            preload="none"
            width={extraFigure.width}
            height={extraFigure.height}
            poster={extraFigure.poster}
            aria-label={extraFigure.alt ?? extraFigure.caption}
            data-lazy-video
            data-zoomable-video
            data-video-mp4={extraFigure.src}
            data-caption={extraFigure.caption}
            tabindex="0"
            role="button"
          ></video>
        ) : (
          <img
            src={extraFigure.src}
            alt={extraFigure.alt ?? extraFigure.caption}
            width={extraFigure.width}
            height={extraFigure.height}
            class="w-full h-auto block cursor-zoom-in"
            data-zoomable
            tabindex="0"
            role="button"
            aria-label={Astro.currentLocale === 'en' ? 'Enlarge figure' : 'Ampliar figura'}
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
      <p class="font-mono text-[13px] text-ink">
        <span class="font-bold text-accent">{extraFigure.number}</span> — {extraFigure.caption}
      </p>
    </div>
  )}
</article>
