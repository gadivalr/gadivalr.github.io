---
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const blogHref = t.locale === 'en' ? '/en/blog/' : '/blog/';
---

<!-- PIE DE PÁGINA -->
<footer class="border-t border-ink py-6 mt-12 bg-paper">
  <div class="max-w-6xl mx-auto px-4 lg:px-10 xl:px-16 flex flex-wrap justify-center items-center gap-x-3 gap-y-1 text-[14px] text-ink">
    <div>{t.footer.copyright}</div>
    <span class="text-ink/40" aria-hidden="true">·</span>
    <a class="link font-mono text-[13px]" href={blogHref}>Blog</a>
  </div>
</footer>
