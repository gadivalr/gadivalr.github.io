---
import type { Dict } from '../i18n';

type FeaturedProject = Dict['projects']['p1'];

interface Props {
  project: FeaturedProject;
  /** Número de figura, p.ej. "Fig. 1.1" */
  figNumber: string;
  figureSrc: string;
  figureAlt: string;
  figureCaption: string;
}

const { project, figNumber, figureSrc, figureAlt, figureCaption } = Astro.props;
---

<!-- HOJA DE CUADERNO -->
<article class="space-y-6 pb-12">
  <div class="flex flex-col md:flex-row md:items-baseline justify-between pb-2 gap-2">
    <div class="flex items-baseline gap-4">
      <span class="font-mono text-4xl md:text-6xl font-light text-accent">{project.number}</span>
      <div>
        <span class="font-mono text-[12px] text-accent tracking-widest uppercase block">{project.kicker}</span>
        <h3 class="font-serif text-xl md:text-3xl font-medium text-ink leading-snug">
          {project.title}
        </h3>
      </div>
    </div>
  </div>

  <!-- Distribución editorial: Marginalia + Columna Principal -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Marginalia / Notas de laboratorio -->
    <aside class="lg:col-span-4 space-y-4 font-mono text-[13px] border border-ink p-4 bg-paper">
      <div class="space-y-1.5">
        {project.params.map((p) => (
          <div><span class="font-bold">{p.label}:</span> {p.value}</div>
        ))}
      </div>
      <div class="border-t border-ink pt-2 text-[12px] text-ink leading-relaxed">
        <span class="font-bold text-accent">{project.marginaliaLabel}</span> {project.marginalia}
      </div>
    </aside>

    <!-- Columna Principal de Lectura -->
    <div class="lg:col-span-8 space-y-5 font-serif text-[17px] leading-relaxed text-ink">
      <div>
        <span class="font-mono text-[13px] font-bold text-accent uppercase tracking-wider block mb-1">{project.problemLabel}</span>
        <p class="font-serif"><span class="to-fill font-mono text-[14px]">{project.problemPlaceholder}</span></p>
      </div>
      <div>
        <span class="font-mono text-[13px] font-bold text-accent uppercase tracking-wider block mb-1">{project.approachLabel}</span>
        <p class="font-serif">{project.approach}</p>
      </div>
      <div>
        <span class="font-mono text-[13px] font-bold text-accent uppercase tracking-wider block mb-1">{project.toolsLabel}</span>
        <p class="font-serif">{project.tools}</p>
      </div>
      <div class="pt-3 space-y-2 font-mono text-[14px]">
        <div>
          <span class="font-bold text-accent">{project.resultLabel}</span> <span class="to-fill">{project.resultPlaceholder}</span>
        </div>
        <div>
          <span class="font-bold text-accent">{project.linksLabel}</span> <span class="to-fill">{project.linksPlaceholder}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Figura técnica -->
  <div class="space-y-2 pt-2">
    <div class="border border-ink overflow-hidden bg-paper">
      <img
        src={figureSrc}
        alt={figureAlt}
        width="512"
        height="286"
        loading="lazy"
        decoding="async"
        class="w-full h-auto block"
      />
    </div>
    <p class="font-mono text-[13px] text-ink">
      <span class="font-bold text-accent">{figNumber}</span> — {figureCaption}
    </p>
  </div>
</article>
