---
import type { Dict } from '../i18n';
import SectionHeading from './SectionHeading.astro';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const c = t.contact;
---

<!-- SECCIÓN CONTACTO SOBRIA Y DIRECTA -->
<section class="space-y-6 pt-2 pb-8 font-mono text-[14px]" id="contacto" aria-labelledby="contacto-title">
  <SectionHeading id="contacto-title" heading={c.heading} tag={c.sectionTag} />
  <div class="space-y-6 pt-2 text-ink">
    <p class="font-serif text-[16px] text-ink leading-relaxed">{c.intro}</p>
    <div class="pb-6">
      <span class="font-mono text-[12px] text-accent tracking-widest uppercase block mb-1">{c.emailLabel}</span>
      <a class="to-fill font-serif text-xl md:text-3xl font-medium" href="#">{c.emailPlaceholder}</a>
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[14px]">
      <div><span class="font-bold text-accent">{c.githubLabel}</span> <a class="to-fill ml-1" href="#">{c.githubPlaceholder}</a></div>
      <span class="text-ink hidden sm:inline" aria-hidden="true">|</span>
      <div><span class="font-bold text-accent">{c.linkedinLabel}</span> <a class="to-fill ml-1" href="#">{c.linkedinPlaceholder}</a></div>
      <span class="text-ink hidden sm:inline" aria-hidden="true">|</span>
      <div><span class="font-bold text-accent">{c.locationLabel}</span> {c.locationValue}</div>
      <span class="text-ink hidden sm:inline" aria-hidden="true">|</span>
      <div><span class="font-bold text-accent">{c.institutionLabel}</span> {c.institutionValue}</div>
    </div>
  </div>
</section>
