---
import type { Dict } from '../i18n';
import SectionHeading from './SectionHeading.astro';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const tr = t.trajectory;
---

<!-- 02. TRAYECTORIA Y PRÁCTICAS -->
<section class="space-y-6 pt-2" id="trayectoria" aria-labelledby="trayectoria-title">
  <SectionHeading id="trayectoria-title" heading={tr.heading} />
  <div class="space-y-4 md:space-y-8 font-mono text-[14px] pt-2">
    <div class="border-l border-ink pl-6 space-y-4 md:space-y-8 relative">
      {tr.entries.map((entry) => (
        <div class="relative space-y-1.5">
          <div class="absolute -left-[31px] top-1.5 w-2.5 h-2.5 bg-accent border border-ink" aria-hidden="true"></div>
          <div class="text-[13px] text-accent font-bold tracking-wider uppercase">{entry.date}</div>
          <h3 class="font-serif text-lg md:text-xl font-medium text-ink">{entry.title}</h3>
          <p class="font-serif text-[15px] text-ink leading-relaxed pt-1">{entry.body}</p>
        </div>
      ))}
    </div>
    <div class="pt-4">
      <a class="inline-block border border-accent text-accent font-mono font-bold px-4 py-2 hover:bg-accent hover:text-paper transition-colors" href={tr.cvHref ?? '#'} target={tr.cvHref ? '_blank' : undefined} rel={tr.cvHref ? 'noopener noreferrer' : undefined} download={tr.cvHref ? '' : undefined}>{tr.cvCta}</a>
    </div>
  </div>
</section>
