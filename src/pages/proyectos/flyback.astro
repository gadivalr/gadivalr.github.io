---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import FlybackSheet from '../../components/FlybackSheet.astro';
import Footer from '../../components/Footer.astro';
import { getDict } from '../../i18n';

const locale = 'es' as const;
const t = getDict(locale);
const meta = t.flyback;
---

<BaseLayout
  locale={locale}
  path="/proyectos/flyback/"
  title={`${meta.title} — Leví Gadiel Sojos González`}
  description="Proyecto de equipo de electrónica de potencia: convertidor flyback aislado de 10 W con telemetría remota (LTspice, PIC18F4550, ESP32, Python/PySide6, KiCad)."
>
  <Header t={t} locale={locale} />
  <main class="max-w-6xl mx-auto px-3 md:px-4 py-8">
    <FlybackSheet t={t} />
  </main>
  <Footer t={t} />
</BaseLayout>
