---
interface Props {
  heading: string;
  tag: string;
  /** id del <h2> para aria-labelledby externo si hace falta */
  id?: string;
}

const { heading, tag, id } = Astro.props;
---

<div class="border-b border-ink pb-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 font-mono text-[14px]">
  <h2 id={id} class="font-serif text-2xl font-semibold text-ink">{heading}</h2>
  <span class="text-accent font-semibold">{tag}</span>
</div>
