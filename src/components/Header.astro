---
import type { Dict, Locale } from '../i18n';

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
---

<header class="w-full border-b border-ink sticky top-0 bg-paper z-50">
  <div class="max-w-6xl mx-auto px-4 py-2 md:py-3 flex flex-col md:flex-row md:items-center md:justify-end gap-1.5 md:gap-2 text-[14px]">

    <!-- Selector de idioma: esquina superior derecha en móvil; junto a los enlaces en desktop -->
    <div class="order-1 md:order-2 flex justify-end md:items-center gap-2">
      <span class="hidden md:inline text-ink/40 select-none" aria-hidden="true">|</span>
      <span class="flex items-center gap-1 font-mono text-[12px] md:text-[13px]" role="group" aria-label={t.langSwitcher.label}>
        <a
          href="/"
          hreflang="es"
          lang="es"
          data-lang-switch="es"
          aria-current={locale === 'es' ? 'true' : undefined}
          class:list={[
            'border px-2 py-1.5 md:py-0.5 transition-colors',
            locale === 'es'
              ? 'border-accent bg-accent text-paper font-semibold'
              : 'border-ink nav-link',
          ]}
        >
          ES
        </a>
        <a
          href="/en/"
          hreflang="en"
          lang="en"
          data-lang-switch="en"
          aria-current={locale === 'en' ? 'true' : undefined}
          class:list={[
            'border px-2 py-1.5 md:py-0.5 transition-colors',
            locale === 'en'
              ? 'border-accent bg-accent text-paper font-semibold'
              : 'border-ink nav-link',
          ]}
        >
          EN
        </a>
      </span>
    </div>

    <nav class="order-2 md:order-1 grid grid-cols-2 gap-2 md:flex md:flex-wrap md:items-center md:justify-end md:gap-2 font-mono text-[12px] md:text-[13px]" aria-label={t.nav.sectionsLabel}>
      <a class="nav-link border border-ink px-2 py-1.5 md:py-0.5 transition-colors text-center" href="#proyectos">{t.nav.projects}</a>
      <a class="nav-link border border-ink px-2 py-1.5 md:py-0.5 transition-colors text-center" href="#trayectoria">{t.nav.trayectoria}</a>
      <a class="nav-link border border-ink px-2 py-1.5 md:py-0.5 transition-colors text-center" href="#habilidades">{t.nav.habilidades}</a>
      <a class="nav-link border border-ink px-2 py-1.5 md:py-0.5 transition-colors text-center" href="#contacto">{t.nav.contacto}</a>
    </nav>
  </div>
</header>

<script>
  // Al cambiar de idioma: persistir elección y conservar el ancla actual (#...)
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        const lang = a.dataset.langSwitch;
        if (lang) localStorage.setItem('lang', lang);
        if (window.location.hash) {
          a.href = a.getAttribute('href') + window.location.hash;
        }
      } catch (e) {
        /* ignore */
      }
    });
  });
</script>
