---
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<!-- PORTADA / HERO (SIN CAJAS NI BORDES EXTERIORES) -->
<section class="space-y-6 pt-4" id="portada">
  <div class="space-y-2">
    <h1 class="font-serif text-3xl md:text-5xl font-semibold text-ink tracking-tight leading-tight text-balance">
      {t.hero.name}
    </h1>
    <p class="font-serif text-lg md:text-xl text-ink leading-relaxed max-w-4xl pt-1">
      {t.hero.intro}
    </p>
    <p class="font-serif text-base md:text-lg text-ink leading-relaxed max-w-4xl">
      {t.hero.seeking}
    </p>
  </div>
  <div class="font-mono text-[14px] text-ink flex flex-wrap items-center gap-x-6 gap-y-2 pt-2">
    <div><span class="font-bold">{t.hero.emailLabel}</span> <a class="to-fill" href="#contacto">{t.hero.emailPlaceholder}</a></div>
    <div><span class="font-bold">{t.hero.githubLabel}</span> <a class="to-fill" href="#">{t.hero.githubPlaceholder}</a></div>
    <div><span class="font-bold">{t.hero.linkedinLabel}</span> <a class="to-fill" href="#">{t.hero.linkedinPlaceholder}</a></div>
    <div><span class="font-bold">{t.hero.langLabel}</span> {t.hero.langValue}</div>
  </div>
</section>
