---
import type { Dict, Locale } from '../i18n';

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const home = locale === 'en' ? '/en/' : '/';
const links = [
  { href: `${home}#proyectos`, label: t.nav.projects },
  { href: `${home}#trayectoria`, label: t.nav.trayectoria },
  { href: `${home}#habilidades`, label: t.nav.habilidades },
  { href: `${home}#contacto`, label: t.nav.contacto },
];
---

<header class="w-full border-b border-ink sticky top-0 bg-paper z-50">
  <div class="max-w-6xl mx-auto px-3 md:px-4 lg:px-10 xl:px-16">
    <!-- Escritorio: nav completa (sin cambios) -->
    <nav class="hidden md:flex items-center justify-end gap-3 font-mono text-[14px] py-3" aria-label={t.nav.sectionsLabel}>
      {links.map((l) => (
        <a class="nav-link border border-ink px-2 py-0.5 transition-colors" href={l.href}>{l.label}</a>
      ))}
      <span class="text-ink/40 select-none ml-2" aria-hidden="true">|</span>
      <span class="flex items-center gap-1" role="group" aria-label={t.langSwitcher.label}>
        <a
          href="/"
          hreflang="es"
          lang="es"
          data-lang-switch="es"
          aria-current={locale === 'es' ? 'true' : undefined}
          class:list={[
            'border px-2 py-0.5 transition-colors',
            locale === 'es' ? 'border-accent bg-accent text-paper font-semibold' : 'border-ink nav-link',
          ]}
        >ES</a>
        <a
          href="/en/"
          hreflang="en"
          lang="en"
          data-lang-switch="en"
          aria-current={locale === 'en' ? 'true' : undefined}
          class:list={[
            'border px-2 py-0.5 transition-colors',
            locale === 'en' ? 'border-accent bg-accent text-paper font-semibold' : 'border-ink nav-link',
          ]}
        >EN</a>
      </span>
    </nav>

    <!-- Móvil: barra compacta -->
    <div class="md:hidden flex items-center justify-between py-2">
      <button
        type="button"
        class="nav-toggle inline-flex items-center gap-2 px-1 py-1.5 font-mono text-[12px] text-ink"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.menuOpen}
        data-open-label={t.nav.menuOpen}
        data-close-label={t.nav.menuClose}
      >
        <span class="nav-toggle-icon relative block w-4 h-3" aria-hidden="true">
          <span class="absolute left-0 top-0 block h-[1.5px] w-4 bg-current transition-transform"></span>
          <span class="absolute left-0 top-[5px] block h-[1.5px] w-4 bg-current transition-opacity"></span>
          <span class="absolute left-0 top-[10px] block h-[1.5px] w-4 bg-current transition-transform"></span>
        </span>
        <span>{t.nav.menu}</span>
      </button>
      <span class="flex items-center gap-1" role="group" aria-label={t.langSwitcher.label}>
        <a
          href="/"
          hreflang="es"
          lang="es"
          data-lang-switch="es"
          aria-current={locale === 'es' ? 'true' : undefined}
          class:list={[
            'min-h-[44px] min-w-[44px] inline-flex items-center justify-center px-3 font-mono text-[12px] transition-colors',
            locale === 'es' ? 'bg-accent text-paper font-semibold' : 'text-ink',
          ]}
        >ES</a>
        <a
          href="/en/"
          hreflang="en"
          lang="en"
          data-lang-switch="en"
          aria-current={locale === 'en' ? 'true' : undefined}
          class:list={[
            'min-h-[44px] min-w-[44px] inline-flex items-center justify-center px-3 font-mono text-[12px] transition-colors',
            locale === 'en' ? 'bg-accent text-paper font-semibold' : 'text-ink',
          ]}
        >EN</a>
      </span>
    </div>
  </div>

  <!-- Móvil: panel superpuesto (no empuja el contenido) -->
  <nav
    id="mobile-menu"
    class="mobile-menu hidden md:hidden absolute left-0 right-0 top-full bg-paper border-b border-ink z-50 shadow-md"
    aria-label={t.nav.sectionsLabel}
  >
    <div class="max-w-6xl mx-auto px-3 font-mono text-[14px]">
      {links.map((l, i) => (
        <a
          class:list={[
            'block py-3 text-ink',
            i < links.length - 1 ? 'border-b border-ink/10' : '',
          ]}
          href={l.href}
        >{l.label}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  // Al cambiar de idioma: persistir elección y conservar el ancla actual (#...)
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        const lang = a.dataset.langSwitch;
        if (lang) localStorage.setItem('lang', lang);
        if (window.location.hash) {
          a.href = a.getAttribute('href') + window.location.hash;
        }
      } catch (e) {
        /* ignore */
      }
    });
  });

  // Menú hamburguesa (móvil) — panel superpuesto
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const icon = toggle.querySelector('.nav-toggle-icon');
    const bars = icon ? icon.querySelectorAll('span') : [];
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) || '');
      menu.classList.toggle('hidden', !open);
      if (bars.length === 3) {
        bars[0].classList.toggle('translate-y-[5px]', open);
        bars[0].classList.toggle('rotate-45', open);
        bars[1].classList.toggle('opacity-0', open);
        bars[2].classList.toggle('-translate-y-[5px]', open);
        bars[2].classList.toggle('-rotate-45', open);
      }
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('click', (e) => {
      if (!menu.classList.contains('hidden') && !menu.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
        setOpen(false);
      }
    });
  }
</script>
