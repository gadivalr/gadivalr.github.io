---
import type { Dict } from '../i18n';
import SectionHeading from './SectionHeading.astro';
import FeaturedProject from './FeaturedProject.astro';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const p = t.projects;
---

<!-- 01. PROYECTOS DESTACADOS: HOJAS DE CUADERNO DE LABORATORIO -->
<section class="space-y-12 pt-2" id="proyectos" aria-labelledby="proyectos-title">
  <SectionHeading id="proyectos-title" heading={p.heading} tag={p.sectionTag} />

  <FeaturedProject
    project={p.p1}
    figNumber="Fig. 1.1"
    figureSrc="/images/fig-1-1.jpg"
    figureAlt={p.p1.figureAlt}
    figureCaption={p.p1.figureCaption}
  />

  <FeaturedProject
    project={p.p2}
    figNumber="Fig. 2.1"
    figureSrc="/images/fig-2-1.jpg"
    figureAlt={p.p2.figureAlt}
    figureCaption={p.p2.figureCaption}
  />

  <!-- PROYECTOS COMPACTOS (03, 04, 05) -->
  <div class="space-y-6 pt-4">
    <div class="pb-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 font-mono text-[14px]">
      <h3 class="font-serif text-lg md:text-xl font-semibold text-ink">{p.others.heading}</h3>
      <span class="text-accent font-semibold">{p.others.sectionTag}</span>
    </div>
    <div class="divide-y divide-ink/15 border-t border-b border-ink/15">
      {p.others.items.map((item) => (
        <article class="py-5 flex flex-col md:flex-row items-baseline gap-4 md:gap-8">
          <div class="font-mono text-3xl md:text-5xl font-light text-accent shrink-0 w-12 md:w-16">{item.number}</div>
          <div class="flex-1 space-y-1">
            <div class="font-mono text-[12px] text-accent tracking-widest uppercase">{item.kicker}</div>
            <h4 class="font-serif text-lg md:text-2xl font-medium text-ink">{item.title}</h4>
            <p class="font-serif text-[15px] text-ink leading-relaxed pt-1">
              {item.body}{' '}<span class="to-fill font-mono text-[14px]">{item.bodyPlaceholder}</span>
            </p>
          </div>
          <div class="w-full md:w-64 shrink-0 font-mono text-[14px] text-ink space-y-1">
            <span class="block text-[12px] font-bold text-accent uppercase tracking-wider">{p.others.toolsLabel}</span>
            <p class="font-serif text-[15px]">
              {item.tools}
              {item.toolsPlaceholder && <span class="to-fill font-mono text-[14px]">{item.toolsPlaceholder}</span>}
            </p>
          </div>
          <div class="w-full md:w-36 shrink-0 font-mono text-[14px] space-y-1">
            <span class="block text-[12px] font-bold text-accent uppercase tracking-wider">{p.others.statusLabel}</span>
            {item.statusFill
              ? <span class="to-fill">{item.status}</span>
              : <span class="font-semibold text-accent">{item.status}</span>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
