---
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
  embedded?: boolean;
}

const { t, embedded = false } = Astro.props;
const f = t.flyback;
---

<!-- FICHA TÉCNICA: FLYBACK (completa como 01/02, o detalle con migas) -->
<article class:list={[embedded ? 'space-y-4 md:space-y-6 pb-6 md:pb-12' : 'space-y-8 pt-4']}>
  {!embedded && (
    <div>
      <a class="link font-mono text-[13px] text-accent font-semibold" href={f.backHref}>{f.back}</a>
    </div>
  )}

  {embedded ? (
    <div class="flex flex-col md:flex-row md:items-baseline justify-between pb-2 gap-2">
      <div class="flex flex-col items-start md:flex-row md:items-center gap-1 md:gap-4 w-full">
        <span class="font-mono text-4xl md:text-6xl font-light text-accent">{f.number}</span>
        <div class="w-full">
          <span class="font-mono text-[12px] text-accent tracking-widest uppercase block">{f.kicker}</span>
          <h3 class="font-serif text-xl md:text-3xl font-medium text-ink leading-snug [hyphens:none] [word-break:normal]">
            {f.title}
          </h3>
        </div>
      </div>
    </div>
  ) : (
    <header class="space-y-3">
      <div class="font-mono text-[12px] text-accent tracking-widest uppercase">{f.kicker}</div>
      <h1 class="font-serif text-2xl md:text-4xl font-semibold text-ink leading-tight text-balance">{f.title}</h1>
    </header>
  )}

  <!-- Caja de datos + columna principal (marginal note/tools movidos a caja) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <aside class="lg:col-span-4 space-y-4 font-mono text-[13px] border border-ink p-4 bg-paper">
      <div class="space-y-1.5">
        {f.params.map((p) => (
          <div><span class="font-bold">{p.label}:</span> {p.value}</div>
        ))}
        {f.tools && !f.params.some((p) => /herramienta|tool/i.test(p.label)) && (
          <div><span class="font-bold">{f.toolsLabel}:</span> {f.tools}</div>
        )}
      </div>
    </aside>

    <div class="lg:col-span-8 space-y-5 font-serif text-[17px] leading-relaxed text-ink">
      <div>
        <span class="font-mono text-[13px] font-bold text-accent uppercase tracking-wider block mb-1">{f.problemLabel}</span>
        <p class="font-serif">{f.problem}</p>
      </div>
      <div>
        <span class="font-mono text-[13px] font-bold text-accent uppercase tracking-wider block mb-1">{f.teamLabel}</span>
        <ul class="font-serif list-disc pl-6 space-y-1.5 marker:text-accent">
          {f.teamItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <span class="font-mono text-[13px] font-bold text-accent uppercase tracking-wider block mb-1">{f.myLabel}</span>
        <ul class="font-serif list-disc pl-6 space-y-1.5 marker:text-accent">
          {f.myItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="pt-3 space-y-2 font-mono text-[14px]">
        <div>
          <span class="font-bold text-accent">{f.resultLabel}</span> {f.result}
        </div>
        <div>
          <span class="font-bold text-accent">{f.linksLabel}</span>{' '}
          {f.linksFill ? (
            <span class="to-fill">{f.links}</span>
          ) : 'linksHref' in f && f.linksHref ? (
            <a class="link" href={f.linksHref} target="_blank" rel="noopener noreferrer">{f.links}</a>
          ) : (
            f.links
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Figuras 4.1–4.4 -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {f.figures.map((fig) => (
      <figure class="space-y-2">
        {'src' in fig && fig.src ? (
          <div class="border border-ink bg-paper overflow-hidden">
            <img
              src={fig.src}
              alt={'alt' in fig && fig.alt ? fig.alt : fig.caption}
              class="block w-full h-auto max-w-full cursor-zoom-in"
              loading="lazy"
              decoding="async"
              data-zoomable
              tabindex="0"
              role="button"
              aria-label={t.locale === 'en' ? 'Enlarge figure' : 'Ampliar figura'}
            />
          </div>
        ) : (
          <div class="border border-dashed border-ink bg-paper h-44 md:h-48 flex items-center justify-center text-center p-4">
            <span class="to-fill font-mono text-[13px]">{'pending' in fig ? fig.pending : '[COMPLETAR]'}</span>
          </div>
        )}
        <figcaption class="font-mono text-[13px] text-ink">
          <span class="font-bold text-accent">{fig.num}</span> — {fig.caption}
        </figcaption>
      </figure>
    ))}
  </div>
</article>
