---
interface Props {
  heading: string;
  /** id del <h2> para aria-labelledby externo si hace falta */
  id?: string;
}

const { heading, id } = Astro.props;
---

<div class="border-b border-ink pb-2 font-mono text-[14px]">
  <h2 id={id} class="font-serif text-xl md:text-2xl font-semibold text-ink">{heading}</h2>
</div>
